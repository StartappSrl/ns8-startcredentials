#
# StartCredentials: pod che raggruppa applicazione e database.
# Solo la porta dell'applicazione è pubblicata, e solo su 127.0.0.1:
# il traffico esterno passa da Traefik in HTTPS.
#
[Unit]
Description=StartCredentials pod
Requires=startcredentials-db.service startcredentials-app.service
Before=startcredentials-db.service startcredentials-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
WorkingDirectory=%E/state
Restart=always
ExecStartPre=/bin/rm -f %t/startcredentials.pid %t/startcredentials.pod-id
ExecStartPre=/usr/bin/podman pod create --infra-conmon-pidfile %t/startcredentials.pid \
    --pod-id-file %t/startcredentials.pod-id \
    --name startcredentials \
    --publish 127.0.0.1:${TCP_PORT}:8080 \
    --replace
ExecStart=/usr/bin/podman pod start --pod-id-file %t/startcredentials.pod-id
ExecStop=/usr/bin/podman pod stop --ignore --pod-id-file %t/startcredentials.pod-id -t 10
ExecStopPost=/usr/bin/podman pod rm --ignore -f --pod-id-file %t/startcredentials.pod-id
PIDFile=%t/startcredentials.pid
Type=forking

[Install]
WantedBy=default.target
