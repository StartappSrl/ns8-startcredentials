#
# PostgreSQL di StartCredentials. Contiene solo dati cifrati dai client.
# restore/ viene montata su docker-entrypoint-initdb.d: al primo avvio
# dopo un ripristino il dump viene caricato automaticamente.
#
[Unit]
Description=StartCredentials database
BindsTo=startcredentials.service
After=startcredentials.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
WorkingDirectory=%E/state
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/startcredentials-db.ctr-id
ExecStartPre=/bin/mkdir -p restore
ExecStart=/usr/bin/podman run --detach \
    --conmon-pidfile=%t/startcredentials-db.pid \
    --cidfile=%t/startcredentials-db.ctr-id \
    --cgroups=no-conmon \
    --pod-id-file %t/startcredentials.pod-id \
    --replace --name=%N \
    --env-file=database.env \
    --volume pgdata:/var/lib/postgresql/data:Z \
    --volume ./restore:/docker-entrypoint-initdb.d:ro,z \
    ${POSTGRES_IMAGE}
ExecStop=/usr/bin/podman stop --ignore --cidfile=%t/startcredentials-db.ctr-id -t 60
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile=%t/startcredentials-db.ctr-id
PIDFile=%t/startcredentials-db.pid
Type=forking

[Install]
WantedBy=default.target
