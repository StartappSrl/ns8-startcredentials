#
# Applicazione StartCredentials (API e pagina iniziale).
#
[Unit]
Description=StartCredentials application
BindsTo=startcredentials.service
After=startcredentials.service startcredentials-db.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
WorkingDirectory=%E/state
Restart=always
TimeoutStopSec=30
ExecStartPre=/bin/rm -f %t/startcredentials-app.ctr-id
ExecStartPre=-runagent discover-smarthost
ExecStart=/usr/bin/podman run --detach \
    --conmon-pidfile=%t/startcredentials-app.pid \
    --cidfile=%t/startcredentials-app.ctr-id \
    --cgroups=no-conmon \
    --pod-id-file %t/startcredentials.pod-id \
    --replace --name=%N \
    --read-only \
    --tmpfs /tmp \
    --env-file=app.env \
    --env-file=smarthost.env \
    --env STARTCREDENTIALS_HOST=${STARTCREDENTIALS_HOST} \
    --env MAX_ATTACHMENT_MB=${STARTCREDENTIALS_MAX_ATTACHMENT_MB:-50} \
    --volume attachments:/srv/attachments:Z \
    ${STARTCREDENTIALS_APP_IMAGE}
ExecStop=/usr/bin/podman stop --ignore --cidfile=%t/startcredentials-app.ctr-id -t 20
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile=%t/startcredentials-app.ctr-id
PIDFile=%t/startcredentials-app.pid
Type=forking

[Install]
WantedBy=default.target
