#!/usr/bin/env python3

#
# Genera una sola volta i segreti dell'istanza: password del database,
# chiave del server (cifra i segreti MFA e firma i token) e codice di
# attivazione per il primo amministratore.
#

import base64
import os
import secrets

os.umask(0o077)

if not os.path.exists("database.env"):
    db_password = secrets.token_urlsafe(32)
    with open("database.env", "w") as f:
        f.write("POSTGRES_USER=startcredentials\n")
        f.write(f"POSTGRES_PASSWORD={db_password}\n")
        f.write("POSTGRES_DB=startcredentials\n")
    with open("app.env", "w") as f:
        f.write(f"DATABASE_URL=postgres://startcredentials:{db_password}@127.0.0.1:5432/startcredentials\n")
        f.write(f"SERVER_SECRET={base64.b64encode(secrets.token_bytes(32)).decode()}\n")
        f.write(f"BOOTSTRAP_TOKEN={secrets.token_urlsafe(24)}\n")
        f.write("ATTACHMENTS_DIR=/srv/attachments\n")
        f.write("NODE_ENV=production\n")

open("smarthost.env", "a").close()
