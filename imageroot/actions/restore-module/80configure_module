#!/usr/bin/env python3

#
# Dopo il ripristino riapplica la configurazione salvata nel backup
# (nome host e Let's Encrypt), che avvia anche i servizi.
#

import json
import os
import sys
import agent
import agent.tasks

request = json.load(sys.stdin)
env = request.get("environment", {})
host = env.get("STARTCREDENTIALS_HOST") or os.environ.get("STARTCREDENTIALS_HOST")
if not host:
    sys.exit(0)

response = agent.tasks.run(
    agent_id=os.environ["AGENT_ID"],
    action="configure-module",
    data={
        "host": host,
        "lets_encrypt": (env.get("STARTCREDENTIALS_LETS_ENCRYPT") or os.environ.get("STARTCREDENTIALS_LETS_ENCRYPT")) == "true",
        "mail_from": env.get("STARTCREDENTIALS_MAIL_FROM") or os.environ.get("STARTCREDENTIALS_MAIL_FROM", ""),
    },
)
agent.assert_exp(response["exit_code"] == 0)
