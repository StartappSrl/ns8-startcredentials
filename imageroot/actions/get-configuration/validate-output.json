{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "get-configuration output",
    "$id": "http://schema.nethserver.org/startcredentials/get-configuration-output.json",
    "description": "Configurazione corrente di StartCredentials",
    "examples": [
        {
            "host": "credenziali.example.com",
            "lets_encrypt": true
        }
    ],
    "type": "object",
    "required": [
        "host",
        "lets_encrypt"
    ],
    "properties": {
        "host": {
            "type": "string"
        },
        "lets_encrypt": {
            "type": "boolean"
        },
        "bootstrap_token": {
            "type": "string"
        }
    }
}