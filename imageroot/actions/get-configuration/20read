import json
import os
import sys


def read_env(path):
    values = {}
    try:
        with open(path) as f:
            for line in f:
                if "=" in line:
                    k, v = line.rstrip("\n").split("=", 1)
                    values[k] = v
    except FileNotFoundError:
        pass
    return values


config = {
    "host": os.environ.get("STARTCREDENTIALS_HOST", ""),
    "lets_encrypt": os.environ.get("STARTCREDENTIALS_LETS_ENCRYPT", "false") == "true",
    # Il codice funziona solo finché non esiste un amministratore:
    # l'applicazione lo invalida al primo utilizzo.
    "bootstrap_token": read_env("app.env").get("BOOTSTRAP_TOKEN", ""),
}

json.dump(config, fp=sys.stdout)
