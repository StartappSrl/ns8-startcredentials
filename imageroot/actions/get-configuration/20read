import json
import os
import sys


def read_env(path):
    values = {}
    try:
        with open(path) as f:
            for line in f:
                if "=" in line:
                    k, v = line.rstrip("\n").split("=", 1)
                    values[k] = v
    except FileNotFoundError:
        pass
    return values


def image_version(image):
    """Versione dall'immagine dell'app, es. ghcr.io/startappsrl/startcredentials-app:0.7.0 -> 0.7.0."""
    if not image or ":" not in image.rsplit("/", 1)[-1]:
        return ""
    return image.rsplit(":", 1)[1]


config = {
    "app_version": image_version(os.environ.get("STARTCREDENTIALS_APP_IMAGE", "")),
    "host": os.environ.get("STARTCREDENTIALS_HOST", ""),
    "lets_encrypt": os.environ.get("STARTCREDENTIALS_LETS_ENCRYPT", "false") == "true",
    "mail_from": os.environ.get("STARTCREDENTIALS_MAIL_FROM", ""),
    "min_password_length": int(os.environ.get("STARTCREDENTIALS_MIN_PASSWORD_LENGTH") or 12),
    "secure_send_enabled": os.environ.get("STARTCREDENTIALS_SECURE_SEND_ENABLED", "1") != "0",
    "secure_send_max_days": int(os.environ.get("STARTCREDENTIALS_SECURE_SEND_MAX_DAYS") or 7),
    "secure_send_domains": ", ".join(os.environ.get("STARTCREDENTIALS_SECURE_SEND_DOMAINS", "").split()),
    # Il codice funziona solo finché non esiste un amministratore:
    # l'applicazione lo invalida al primo utilizzo.
    "bootstrap_token": read_env("app.env").get("BOOTSTRAP_TOKEN", ""),
}

json.dump(config, fp=sys.stdout)
