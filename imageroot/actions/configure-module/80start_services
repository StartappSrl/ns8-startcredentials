set -e

touch smarthost.env

# Al primo avvio abilita il pod, ai successivi applica la nuova configurazione.
if systemctl --user -q is-active startcredentials.service; then
    systemctl --user restart startcredentials-app.service
else
    systemctl --user enable --now startcredentials.service
fi
