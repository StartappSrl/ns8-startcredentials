import json
import sys
import os
import agent
import agent.tasks

request = json.load(sys.stdin)
host = request["host"]
lets_encrypt = request["lets_encrypt"]

# Persist the configuration in the module environment
agent.set_env("STARTCREDENTIALS_HOST", host)
agent.set_env("STARTCREDENTIALS_LETS_ENCRYPT", "true" if lets_encrypt else "false")

# StartCredentials must be reachable only through HTTPS on its own
# host name: the browser extension and the mobile app refuse plain HTTP.
response = agent.tasks.run(
    agent_id=agent.resolve_agent_id("traefik@node"),
    action="set-route",
    data={
        "instance": os.environ["MODULE_ID"],
        "url": "http://127.0.0.1:" + os.environ["TCP_PORT"],
        "host": host,
        "http2https": True,
        "lets_encrypt": lets_encrypt,
    },
)
agent.assert_exp(response["exit_code"] == 0)
